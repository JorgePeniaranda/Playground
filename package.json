{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "precommit": "npm run format:check && npm run lint:all",
    "prepush": "npm run typecheck:all && npm run test:all",
    "dev": "node ./scripts/run-workspace-command.mjs dev",
    "dev:react": "npm run dev -w react-playground",
    "dev:ts": "npm run dev -w ts-playground",
    "dev:utils": "npm run dev -w @playground/utils",
    "build": "node ./scripts/run-workspace-command.mjs build",
    "build:all": "npm run build:packages && npm run build:react && npm run build:ts",
    "build:packages": "node ./scripts/build-packages.mjs",
    "build:react": "npm run build -w react-playground",
    "build:ts": "npm run build -w ts-playground",
    "lint": "node ./scripts/run-workspace-command.mjs lint",
    "lint:all": "eslint .",
    "lint:fix": "node ./scripts/run-workspace-command.mjs lint:fix",
    "lint:fix:all": "eslint . --fix",
    "lint:react": "npm run lint -w react-playground",
    "lint:ts": "npm run lint -w ts-playground",
    "lint:utils": "npm run lint -w @playground/utils",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:react": "npm run format -w react-playground",
    "format:ts": "npm run format -w ts-playground",
    "format:utils": "npm run format -w @playground/utils",
    "typecheck": "node ./scripts/run-workspace-command.mjs typecheck",
    "typecheck:all": "npm run typecheck:utils && npm run typecheck:react && npm run typecheck:ts",
    "typecheck:react": "npm run typecheck -w react-playground",
    "typecheck:ts": "npm run typecheck -w ts-playground",
    "typecheck:utils": "npm run typecheck -w @playground/utils",
    "test": "node ./scripts/run-workspace-command.mjs test",
    "test:all": "npm test --workspaces",
    "test:react": "npm run test -w react-playground",
    "test:ts": "npm run test -w ts-playground",
    "test:utils": "npm run test -w @playground/utils",
    "test:watch": "node ./scripts/run-workspace-command.mjs test:watch",
    "test:watch:react": "npm run test:watch -w react-playground",
    "test:watch:ts": "npm run test:watch -w ts-playground",
    "test:watch:utils": "npm run test:watch -w @playground/utils",
    "test:coverage": "node ./scripts/run-workspace-command.mjs test:coverage",
    "check": "node ./scripts/run-workspace-command.mjs check",
    "check:all": "npm run lint:all && npm run format:check && npm run typecheck:all && npm run test:all",
    "check:react": "npm run check -w react-playground",
    "check:ts": "npm run check -w ts-playground",
    "check:utils": "npm run check -w @playground/utils"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/mocha": "10.0.10",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0"
  }
}

{
  "name": "angular-playground",
  "version": "0.0.0",
  "private": true,
  "playgroundConfig": {
    "id": "angular",
    "label": "Angular Playground"
  },
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "clean": "node ../../scripts/clean-workspace.mjs .angular dist out-tsc coverage",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@playground/utils": "0.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "4.2.2",
    "jsdom": "^28.0.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}

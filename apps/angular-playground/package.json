{
  "name": "angular-playground",
  "version": "0.0.0",
  "private": true,
  "playgroundConfig": {
    "id": "angular",
    "label": "Angular Playground"
  },
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "clean": "node ../../cli/features/cleanup/clean-workspace.mjs .angular dist out-tsc coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --code-coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/forms": "21.2.7",
    "@angular/platform-browser": "21.2.7",
    "@angular/router": "21.2.7",
    "@playground/utils": "0.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.6",
    "@angular/cli": "21.2.6",
    "@angular/compiler-cli": "21.2.7",
    "@tailwindcss/postcss": "4.2.2",
    "jsdom": "29.0.1",
    "postcss": "8.5.8",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  }
}

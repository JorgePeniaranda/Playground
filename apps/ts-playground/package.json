{
  "name": "ts-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "playgroundConfig": {
    "id": "ts",
    "label": "TypeScript Playground"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node ./out/index.js",
    "start:dev": "node --loader ts-node/esm index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@playground/utils": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@vitest/coverage-v8": "4.1.2",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "vitest": "4.1.2"
  }
}

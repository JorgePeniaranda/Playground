{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ts-playground: Dev (Nodemon)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nodemon", "--exec", "node --loader ts-node/esm --inspect"],
      "args": ["index.ts"],
      "cwd": "${workspaceFolder}/apps/ts-playground",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "TS_NODE_PROJECT": "${workspaceFolder}/apps/ts-playground/tsconfig.json"
      },
      "restart": true,
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/apps/ts-playground/**",
        "!**/node_modules/**"
      ],
      "autoAttachChildProcesses": true
    },
    {
      "name": "react-playground: Dev + Debug",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "react-playground: dev",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/react-playground",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/apps/react-playground/src/*",
        "/*": "${workspaceFolder}/apps/react-playground/*",
        "/@fs/*": "*"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "angular-playground: Dev + Debug",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "angular-playground: dev",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/angular-playground",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
